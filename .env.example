# Copy to .env and fill in. Never commit .env.

# --- service ---
LOG_LEVEL=INFO

# --- security ---
# Set a value to require X-API-Key on every request. Empty = disabled (dev only).
API_KEY=

# --- risk engine business parameters ---
INTERVENTION_COST=10
RETAINED_VALUE=120
INTERVENTION_EFFECT=0.35

# --- model ---
# Empty = use latest bundle in artifacts/model/
MODEL_VERSION=

# --- rate limiting ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- drift ---
DRIFT_PSI_THRESHOLD=0.2
